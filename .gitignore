/build/
/build-*/
*.o
*.a
*.so
*.exe

# Real personal DJ library data used for local testing against actual
# hardware exports - not for version control (size + personal data).
/testdata/

# Backups Seabass creates before a mutating write (e.g. under
# .seabass-backups/ next to whatever it just backed up) -- local-only,
# never meant to be committed, including under test fixtures.
.seabass-backups/
.seabass.log

# SQLite's side files beside a fixture's OneLibrary mirror. Reading the
# mirror creates them, so any test run leaves them in tests/fixtures/ and
# every checkout looks dirty. They are transient by definition and a -wal
# holds PRE-write pages, which is exactly the content an anonymized
# fixture must not carry -- the anonymizer deletes them before it zips
# an export for the same reason.
tests/fixtures/**/*.db-wal
tests/fixtures/**/*.db-shm
tests/fixtures/**/*-journal

# Claude Code project memory, moved here from ~/.claude/projects/.../
# memory/ so it's readable from other machines this repo is checked
# out on -- local-only by default, not confirmed for git tracking.
/.claude/

# Real webserver host/path for the website deploy scripts -- local-only,
# never committed (see website/scripts/deploy.sh).
/website/scripts/deploy.local.env

# Generated by scripts/init-submodules.sh (and automatically by cmake
# configure) from cmake/dependency-submodules.txt -- never committed as
# .gitmodules itself: KDE Invent's commit audit rejects any pushed
# commit containing a file with that exact name.
/.gitmodules

# Kate swap files
.*.kate-swp

# Compiled Craft blueprint bytecode
__pycache__/
