IDI_ICON1 ICON "app_icon.ico"
// MSVC merges app.manifest at link time (CMakeLists.txt); MinGW embeds it
// here. __GNUC__, not _MSC_VER: rc.exe defines neither, windres runs gcc -E.
#ifdef __GNUC__
1 24 "app.manifest"
#endif
